{
  "name": "jprot-vscode",
  "displayName": "JPROT",
  "description": "JPROT Markdown syntax highlighting (frontmatter, :::Component shortcodes, [value] placeholders) and snippets for pages, posts, projects, resumes and jprot.config.js. No runtime code.",
  "version": "0.2.1",
  "publisher": "moaaz-i",
  "license": "MIT",
  "icon": "media/jprot-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "jprot",
    "markdown",
    "portfolio",
    "static-site",
    "ssg",
    "snippets",
    "no-build"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Moaaz-i/JPROT.git",
    "directory": "jprot-vscode"
  },
  "homepage": "https://github.com/Moaaz-i/JPROT#readme",
  "bugs": {
    "url": "https://github.com/Moaaz-i/JPROT/issues"
  },
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.markdown.jprot",
        "path": "./syntaxes/jprot-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter": "yaml"
        }
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.code-snippets"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript.code-snippets"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}